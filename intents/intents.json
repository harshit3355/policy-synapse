{
  "version": "0.1",
  "intents": [
    {"id": "prod-signed-images", "title": "Production workloads run signed images", "criticality": 3,
     "surfaces": ["ci", "admission", "runtime"],
     "scope": [["env", "eq", "prod"]], "require": [["signed", "is_true"]]},
    {"id": "prod-digest-pinned", "title": "Production images are pinned by digest", "criticality": 2,
     "surfaces": ["ci", "admission", "runtime"],
     "scope": [["env", "eq", "prod"]], "require": [["image_digest_pinned", "is_true"]]},
    {"id": "prod-approved-registry", "title": "Production images come from the production registry", "criticality": 3,
     "surfaces": ["ci", "admission", "runtime"],
     "scope": [["env", "eq", "prod"]], "require": [["image_registry", "eq", "prodregistry.example.com"]]},
    {"id": "approved-registries", "title": "All images come from an approved registry", "criticality": 2,
     "surfaces": ["ci", "admission", "runtime"],
     "require": [["image_registry", "in", ["prodregistry.example.com", "ghcr.io"]]]},
    {"id": "no-docker-hub", "title": "No image is pulled from Docker Hub", "criticality": 1,
     "surfaces": ["ci", "admission", "runtime"],
     "require": [["image_registry", "ne", "docker.io"]]},
    {"id": "prod-encryption-at-rest", "title": "Production data is encrypted at rest", "criticality": 3,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["env", "eq", "prod"]], "require": [["encryption_at_rest", "is_true"]]},
    {"id": "prod-eu-residency", "title": "Production stays in EU regions", "criticality": 3,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["env", "eq", "prod"]], "require": [["region", "in", ["westeurope", "northeurope"]]]},
    {"id": "restricted-single-region", "title": "Restricted data stays in westeurope", "criticality": 2,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["data_class", "eq", "restricted"]], "require": [["region", "eq", "westeurope"]]},
    {"id": "confidential-not-public", "title": "Confidential and restricted data is never publicly reachable",
     "criticality": 3, "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["data_class", "in", ["confidential", "restricted"]]], "require": [["public_ingress", "is_false"]]},
    {"id": "confidential-encrypted", "title": "Confidential and restricted data is encrypted at rest",
     "criticality": 3, "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["data_class", "in", ["confidential", "restricted"]]], "require": [["encryption_at_rest", "is_true"]]},
    {"id": "prod-not-public", "title": "Production is not publicly reachable", "criticality": 2,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["env", "eq", "prod"]], "require": [["public_ingress", "is_false"]]},
    {"id": "nonprod-not-public", "title": "Dev and staging are not publicly reachable", "criticality": 1,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["env", "in", ["dev", "staging"]]], "require": [["public_ingress", "is_false"]]},
    {"id": "owner-required", "title": "Every resource declares an owning team", "criticality": 1,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "require": [["owner", "ne", ""]]},
    {"id": "prod-data-class-declared", "title": "Production declares a valid data classification", "criticality": 2,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["env", "eq", "prod"]],
     "require": [["data_class", "in", ["public", "internal", "confidential", "restricted"]]]},
    {"id": "prod-run-as-non-root", "title": "Production pods run as non-root", "criticality": 2,
     "surfaces": ["ci", "admission"],
     "scope": [["env", "eq", "prod"]], "require": [["run_as_non_root", "is_true"]]},
    {"id": "no-privileged-containers", "title": "No container runs privileged", "criticality": 3,
     "surfaces": ["ci", "admission", "runtime"],
     "require": [["privileged", "is_false"]]},
    {"id": "prod-min-replicas", "title": "Production runs at least two replicas", "criticality": 2,
     "surfaces": ["ci", "admission"],
     "scope": [["env", "eq", "prod"]], "require": [["replicas", "ge", 2]]},
    {"id": "dev-max-replicas", "title": "Dev runs at most three replicas", "criticality": 1,
     "surfaces": ["ci", "admission"],
     "scope": [["env", "eq", "dev"]], "require": [["replicas", "le", 3]]},
    {"id": "prod-supply-chain", "title": "Production images are signed, digest-pinned and from the production registry",
     "criticality": 3, "surfaces": ["ci", "admission", "runtime"],
     "scope": [["env", "eq", "prod"]],
     "require": [["signed", "is_true"], ["image_digest_pinned", "is_true"],
                 ["image_registry", "eq", "prodregistry.example.com"]]},
    {"id": "prod-baseline", "title": "Production is encrypted, private, EU-resident and owned", "criticality": 3,
     "surfaces": ["ci", "admission", "terraform", "runtime"],
     "scope": [["env", "eq", "prod"]],
     "require": [["encryption_at_rest", "is_true"], ["public_ingress", "is_false"],
                 ["region", "in", ["westeurope", "northeurope"]], ["owner", "ne", ""]]}
  ]
}
